{
	"name": "x-cli",
	"version": "0.1.0",
	"packageManager": "pnpm@10.34.7",
	"description": "x-cli: operate X from the command line. The command is `xx` — read a conversation, post a reply, and leave a receipt",
	"type": "module",
	"license": "MIT",
	"bin": {
		"xx": "dist/cli.js"
	},
	"files": [
		"dist",
		"skills",
		"README.md",
		"README.en.md",
		"AGENTS.md",
		"docs/assets",
		"LICENSE",
		"!dist/**/*.map"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "node scripts/build.ts",
		"check": "biome check . && tsc --noEmit",
		"format": "biome check --write .",
		"test": "node scripts/test.ts",
		"test:browser": "node scripts/test-browser.ts",
		"start": "node dist/cli.js"
	},
	"dependencies": {
		"commander": "15.0.0",
		"playwright-core": "1.64.1",
		"proper-lockfile": "4.1.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@types/node": "22.19.19",
		"@types/proper-lockfile": "4.1.4",
		"esbuild": "0.28.2",
		"typescript": "5.9.3"
	}
}
